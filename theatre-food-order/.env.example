# Copy this file's contents into Cloudflare Pages > Settings > Environment Variables.
# Do not commit a real .env file to GitHub.

# Neon Postgres connection string (from Neon dashboard > Connection Details)
# Must include ?sslmode=require
DATABASE_URL=postgres://USER:PASSWORD@YOUR-NEON-HOST/neondb?sslmode=require

# Razorpay TEST MODE keys (from Razorpay dashboard > Settings > API Keys, with Test Mode toggled ON)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# PINs staff/admin type in on their phones to unlock the dashboards. Pick your own numbers.
STAFF_PIN=1234
ADMIN_PIN=9999
